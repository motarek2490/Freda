rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // 1. User images and uploads (Galleries, Groom/Bride photos, Covers)
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 25 * 1024 * 1024;
      allow delete: if isSignedIn();
    }

    // 2. Audio tracks (full tracks and previews)
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 35 * 1024 * 1024;
      allow delete: if isSignedIn();
    }

    // 3. Admin & shared music library catalog
    match /library/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 35 * 1024 * 1024;
      allow delete: if isSignedIn();
    }

    // 4. General images directory
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 25 * 1024 * 1024;
      allow delete: if isSignedIn();
    }
  }
}
