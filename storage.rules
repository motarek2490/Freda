rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // 1. User images (Galleries, Groom/Bride photos, Covers)
    match /users/{userId}/images/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() &&
        request.resource.size < 15 * 1024 * 1024;
      allow delete: if isSignedIn();
    }

    // 2. User audio tracks
    match /users/{userId}/audio/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() &&
        request.resource.size < 30 * 1024 * 1024;
      allow delete: if isSignedIn();
    }

    // 3. Admin & shared music library catalog
    match /library/audio/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() &&
        request.resource.size < 30 * 1024 * 1024;
      allow delete: if isSignedIn();
    }
  }
}
