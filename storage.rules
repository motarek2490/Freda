rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email == 'mohammedtarek2490@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // 1. User images (Galleries, Groom/Bride photos, Covers) — owner or admin only
    match /users/{userId}/images/{fileName} {
      allow read: if true;
      allow write: if (isOwner(userId) || isAdmin()) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 2. User audio tracks — owner or admin only
    match /users/{userId}/audio/{fileName} {
      allow read: if true;
      allow write: if (isOwner(userId) || isAdmin()) &&
        request.resource.size < 25 * 1024 * 1024 &&
        (request.resource.contentType.matches('audio/.*') || request.resource.contentType == 'application/octet-stream');
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Catch-all for any other path under a user's own folder (e.g. new upload
    // kinds added later) — still gated to the owner or an admin, never public.
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isOwner(userId) || isAdmin()) &&
        request.resource.size < 25 * 1024 * 1024;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 3. Admin-managed shared music library catalog
    match /library/audio/{fileName} {
      allow read: if true;
      allow write, delete: if (isAdmin() || isSignedIn()) &&
        request.resource.size < 25 * 1024 * 1024 &&
        (request.resource.contentType.matches('audio/.*') || request.resource.contentType == 'application/octet-stream');
    }

    match /library/{allPaths=**} {
      allow read: if true;
      allow write, delete: if (isAdmin() || isSignedIn()) &&
        request.resource.size < 35 * 1024 * 1024;
    }

    // 4. General images directory (e.g. gift/bank QR uploads, misc assets)
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn();
    }

    // 5. Audio previews/full tracks outside a user folder — signed-in only.
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() &&
        request.resource.size < 25 * 1024 * 1024 &&
        (request.resource.contentType.matches('audio/.*') || request.resource.contentType == 'application/octet-stream');
      allow delete: if isSignedIn();
    }
  }
}
