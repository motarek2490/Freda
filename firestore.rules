rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL SECURITY HELPERS (Zero-Trust ABAC)
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'mohammedtarek2490@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*mohammedtarek2490@gmail.com.*')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function hostActive(invId) {
      return isSignedIn() &&
        request.auth.token.hostOf == invId &&
        get(/databases/$(database)/documents/invitations/$(invId)).data.status != 'expired';
    }

    function isValidSlug(s) {
      return s is string && s.size() >= 1 && s.size() <= 128;
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1.2 /admins/{id} - System Administrators Collection
    // =========================================================================
    match /admins/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =========================================================================
    // 1.3 /invitations/{id} - Core Public/Client Invitations
    // =========================================================================
    match /invitations/{id} {
      // Single doc public view (only published & non-expired invitations are publicly accessible)
      allow get: if (
        resource.data.status == 'published' &&
        resource.data.isExpired != true
      ) ||
      isAdmin() ||
      isOwner(resource.data.ownerUid) ||
      hostActive(id);

      // Collection list queries allowed for admins or authenticated staff/users
      allow list: if isAdmin() || isSignedIn();

      // Creation allowed for any client submitting an order (pending_approval) or owner/admin
      allow create: if request.resource.data.id == id && (
        isAdmin() ||
        request.resource.data.status == 'pending_approval' ||
        request.resource.data.status == 'draft' ||
        (isSignedIn() && request.resource.data.ownerUid == request.auth.uid)
      );

      // Update by Admin, Owner, or client finalizing draft/pending_approval order
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid
      ) || (
        resource.data.status in ['draft', 'pending_approval'] &&
        request.resource.data.status in ['draft', 'pending_approval']
      );

      // Deletion is allowed by Admin or Owner
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      // =======================================================================
      // 1.5 Subcollection: /invitations/{id}/rsvps/{rsvpId}
      // =======================================================================
      match /rsvps/{rsvpId} {
        // Public guests can create an RSVP only on published, active invitations
        allow create: if exists(/databases/$(database)/documents/invitations/$(id)) &&
          get(/databases/$(database)/documents/invitations/$(id)).data.status == 'published' &&
          request.resource.data.id == rsvpId &&
          request.resource.data.invitationId == id &&
          request.resource.data.guestName is string &&
          request.resource.data.guestName.size() >= 2 &&
          request.resource.data.guestName.size() <= 100 &&
          request.resource.data.status in ['attending', 'declined', 'tentative', 'maybe'] &&
          request.resource.data.guestCount is number &&
          request.resource.data.guestCount >= 1 &&
          request.resource.data.guestCount <= 20;

        // Read, update, and manage RSVPs: Admin OR Owner OR Active Host
        allow read, update, delete: if isAdmin() ||
          (isSignedIn() && get(/databases/$(database)/documents/invitations/$(id)).data.ownerUid == request.auth.uid) ||
          hostActive(id);
      }
    }

    // =========================================================================
    // 1.4 /slugs/{slug} - Clean Slug Routing (No alias docs, atomic ownership)
    // =========================================================================
    match /slugs/{slug} {
      allow get: if true;
      allow list: if false;

      allow create: if !exists(/databases/$(database)/documents/slugs/$(slug));

      allow update: if isAdmin() || (
        isSignedIn() && resource.data.ownerUid == request.auth.uid
      ) || (
        request.resource.data.invitationId == resource.data.invitationId
      );

      allow delete: if isAdmin() || isSignedIn();
    }

    // =========================================================================
    // 1.6 /wishes/{wishId} - Guest Wishes & Congratulatory Messages
    // =========================================================================
    match /wishes/{wishId} {
      allow create: if exists(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)) &&
        get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status == 'published' &&
        request.resource.data.approved == false &&
        request.resource.data.authorName is string &&
        request.resource.data.authorName.size() >= 2 &&
        request.resource.data.authorName.size() <= 100 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 2 &&
        request.resource.data.message.size() <= 1000 &&
        (!('relationship' in request.resource.data) || (request.resource.data.relationship is string && request.resource.data.relationship.size() <= 100)) &&
        request.resource.data.keys().hasOnly([
          'id', 'invitationId', 'authorName', 'message', 'relationship', 'approved', 'createdAt'
        ]);

      // Public reads only approved messages; Admin / Owner / Host see all
      allow read: if resource.data.approved == true ||
        isAdmin() ||
        (isSignedIn() && get(/databases/$(database)/documents/invitations/$(resource.data.invitationId)).data.ownerUid == request.auth.uid) ||
        hostActive(resource.data.invitationId);

      allow update, delete: if isAdmin() ||
        (isSignedIn() && get(/databases/$(database)/documents/invitations/$(resource.data.invitationId)).data.ownerUid == request.auth.uid) ||
        hostActive(resource.data.invitationId);
    }

    // =========================================================================
    // 1.8 /invitation_private/{id} - Server Only Credentials Vault
    // =========================================================================
    match /invitation_private/{id} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1.9 /orders/{id} - Package Orders with Price Integrity
    // =========================================================================
    match /orders/{id} {
      allow create: if request.resource.data.id == id &&
        (request.resource.data.status == 'pending' || isAdmin());

      // Single order doc lookup allowed for customer tracking by Order ID; list allowed for admin or signed-in users
      allow get: if true;
      allow list: if isAdmin() || isSignedIn();

      // Update and deletion strictly restricted to Admin
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 1.10 Settings, Music Library, Templates, Reviews, Rate Limits
    // =========================================================================
    match /settings/public_config {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/admin_config {
      allow read, write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if id == 'public_config' || id == 'visitor_stats' || isAdmin();
      allow write: if id == 'visitor_stats' || isAdmin();
    }

    match /music_library/{id} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
      allow delete: if isAdmin();
    }

    match /cloud_audio_files/{id} {
      allow read: if true;
      allow write, delete: if isAdmin() || isSignedIn();
    }

    match /custom_templates/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /rate_limits/{id} {
      allow read, write: if false;
    }
  }
}
