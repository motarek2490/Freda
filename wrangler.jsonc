{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frida",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/i/*", "/portal/*"]
  },
  "vars": {
    "SITE_URL": "https://frida.invitationes.workers.dev",
    "BRAND_NAME": "FRIDA",
    "BRAND_NAME_AR": "فريدا",
    "FIREBASE_PROJECT_ID": "gen-lang-client-0740490915",
    "FIRESTORE_DATABASE_ID": "ai-studio-vowly-eb6a19f5-9126-4bbb-b06c-270aac6778bf"
  },
  "observability": {
    "enabled": true
  }
}
